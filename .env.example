# ─────────────────────────────────────────────────────────────────────────────
# MedInsight AI — Environment Configuration Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The app works WITHOUT any API key (rule-based fallback reports are used).
# Add ONE of the LLM keys below to enable AI-generated clinical reports.
# ─────────────────────────────────────────────────────────────────────────────


# ── LLM Provider (choose ONE) ─────────────────────────────────────────────────

# Option A: NVIDIA NIM (free tier available at build.nvidia.com)
# Get your key → https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY

# Option B: Groq (fast, free tier available at console.groq.com)
# Get your key → https://console.groq.com/keys
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Option C: OpenAI
# Get your key → https://platform.openai.com/api-keys
OPENAI_API_KEY=YOUR_OPENAI_API_KEY


# ── LLM Model Override (optional) ────────────────────────────────────────────
# Defaults: NVIDIA=meta/llama-3.3-70b-instruct | Groq=llama3-70b-8192 | OpenAI=gpt-4o-mini
# LLM_MODEL=meta/llama-3.3-70b-instruct


# ── FastAPI Backend ───────────────────────────────────────────────────────────
# URL the Streamlit frontend uses to reach the FastAPI backend.
# Change this if running on a different host/port.
BACKEND_URL=http://localhost:8000


# ── Application Settings ──────────────────────────────────────────────────────
# Environment: development | production
APP_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
